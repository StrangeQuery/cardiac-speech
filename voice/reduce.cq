; A step's A and a coefficient K (k = K/1000) in, the five cards a lattice machine's multiply routine is made of
; out: the sign word (ADD t or SUB t, t being cell 86 in every lattice machine), the jumps into the row of ADDs for
; k's second and first digits (JMP 99-d), SFT 0L, and the rounding half, 5 x 10^(L-1). k keeps two digits from its
; first one, L: L is 1 for |K| from 100, 2 from 10, 3 below; for L = 1 the second digit is rounded, and 0.995 and up
; stay 0.99. In a step whose A is 0 the cards are those of k = 0 whatever K is, four SFT 00 and a half of 0: each
; multiply gives 0, so in a pause the lattice passes its input straight through and its state drains away, and
; SFT 00, which does nothing, costs one instruction where JMP 99 costs two.
;
; Address Contents Label Opcode Operand Comment
  03            loop    INP   a        03-13: the step's A and K; in a step with A = 0, the cards of k = 0
  04                    INP   k
  05                    CLA   z
  06                    SUB   a
  07                    TAC   sound
  08                    OUT   nop
  09                    OUT   nop
  10                    OUT   nop
  11                    OUT   nop
  12                    OUT   z
  13                    JMP   loop
  14            sound   CLA   k        14-26: the sign word, and m = |K|
  15                    TAC   neg
  16                    CLA   wadd
  17                    STO   sw
  18                    CLA   k
  19                    JMP   mag
  20            neg     CLA   wsub
  21                    STO   sw
  22                    CLA   z
  23                    SUB   k
  24            mag     STO   m
  25                    SUB   c100     25-39: L = 1, n = (m + 5) / 10, at most 99
  26                    TAC   small
  27                    CLA   m
  28                    ADD   five
  29                    SFT   01
  30                    STO   n
  31                    SUB   c100
  32                    TAC   l1
  33                    CLA   c99
  34                    STO   n
  35            l1      CLA   f401
  36                    STO   fin
  37                    CLA   five
  38                    STO   h
  39                    JMP   out
  40            small   CLA   m        40-49: L = 2, n = m
  41                    SUB   ten
  42                    TAC   l3
  43                    CLA   m
  44                    STO   n
  45                    CLA   f402
  46                    STO   fin
  47                    CLA   fifty
  48                    STO   h
  49                    JMP   out
  50            l3      CLA   m        50-56: L = 3, n = 10 m
  51                    SFT   10
  52                    STO   n
  53                    CLA   f403
  54                    STO   fin
  55                    CLA   c500
  56                    STO   h
  57            out     OUT   sw       57-74: the five cards; SFT 33 keeps n's last digit, SFT 01 drops it
  58                    CLA   n
  59                    SFT   33
  60                    STO   d
  61                    CLA   c899
  62                    SUB   d
  63                    STO   d
  64                    OUT   d
  65                    CLA   n
  66                    SFT   01
  67                    STO   d
  68                    CLA   c899
  69                    SUB   d
  70                    STO   d
  71                    OUT   d
  72                    OUT   fin
  73                    OUT   h
  74                    JMP   loop
  75            k       DATA  0
  76            sw      DATA  0
  77            m       DATA  0
  78            n       DATA  0
  79            fin     DATA  0
  80            h       DATA  0
  81            d       DATA  0
  82            z       DATA  0
  83            wadd    ADD   86
  84            wsub    SUB   86
  85            c100    DATA  100
  86            c99     DATA  99
  87            five    DATA  5
  88            ten     DATA  10
  89            fifty   DATA  50
  90            c500    DATA  500
  91            c899    DATA  899
  92            f401    SFT   01
  93            f402    SFT   02
  94            f403    SFT   03
  95            nop     SFT   00
  96            a       DATA  0
