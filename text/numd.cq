; A number's digits. Cards pass through except digits (500 + d), up to the number's end (-12). Leading zeros are
; dropped; the digits after them are held back, six at most, as two numbers of three digits, hi and lo, each new
; digit shifted in at the end of lo and lo's first into hi. At the end, with six digits or fewer: -15, the count,
; hi and lo (the last six digits, zeros in front), for unpack. With seven or more: when the seventh comes, -17, hi
; and lo (the first six), and then each digit from the seventh on as a word card, 700 + d.
;
; Address Contents Label Opcode Operand Comment
  03            rec     INP   x        03-15: a digit, the number's end, or another card
  04                    CLA   x
  05                    SUB   c500
  06                    TAC   nd
  07                    SUB   n10
  08                    TAC   dig
  09            nd      CLA   x
  10                    ADD   n12
  11                    TAC   po
  12                    SUB   00
  13                    TAC   end
  14            po      OUT   x
  15                    JMP   rec
  16            dig     CLA   x        16-50: a digit: dropped (a leading zero), held back, or out
  17                    SUB   c500
  18                    STO   d
  19                    ADD   cnt
  20                    SUB   00
  21                    TAC   rec
  22                    CLA   cnt
  23                    SUB   n6
  24                    TAC   keep
  25                    SUB   00
  26                    TAC   flush
  27                    JMP   long
  28            flush   OUT   m17
  29                    OUT   hi
  30                    OUT   lo
  31            long    CLA   x
  32                    ADD   c200
  33                    STO   x
  34                    OUT   x
  35                    JMP   inc
  36            keep    CLA   lo
  37                    SFT   02
  38                    STO   t
  39                    CLA   hi
  40                    SFT   10
  41                    ADD   t
  42                    STO   hi
  43                    CLA   lo
  44                    SFT   10
  45                    ADD   d
  46                    STO   lo
  47            inc     CLA   cnt
  48                    ADD   00
  49                    STO   cnt
  50                    JMP   rec
  51            end     CLA   cnt      51-64: the end: six digits or fewer: -15, the count, hi and lo
  52                    SUB   n6
  53                    SUB   00
  54                    TAC   short
  55                    JMP   rst
  56            short   OUT   m15
  57                    OUT   cnt
  58                    OUT   hi
  59                    OUT   lo
  60            rst     CLA   z
  61                    STO   hi
  62                    STO   lo
  63                    STO   cnt
  64                    JMP   rec
  70            x       DATA  0
  71            d       DATA  0
  72            cnt     DATA  0
  73            hi      DATA  0
  74            lo      DATA  0
  75            t       DATA  0
  76            z       DATA  0
  77            c500    DATA  500
  78            n10     DATA  10
  79            n12     DATA  12
  80            n6      DATA  6
  81            c200    DATA  200
  82            m15     DATA  -15
  83            m17     DATA  -17
