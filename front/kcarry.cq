; A silent frame keeps the filter of the frame before it. Per frame eleven cards in, snd and K10..K1; out, the
; frame's Ks: its own if it sounds (snd 1), else the ones before again (zeros before the first frame). The Ks are
; read into cells 80-89 and kept in 70-79; the instructions that reach them are moved on a cell for each K.
;
; Address Contents Label Opcode Operand Comment
  03            frm     INP   snd      03-11: a frame, its Ks into 80-89
  04                    CLA   i80
  05                    STO   rd
  06            rd      DATA  0        (INP 80 + k)
  07                    CLA   rd
  08                    ADD   00
  09                    STO   rd
  10                    SUB   i90
  11                    TAC   rd
  12                    CLA   snd      12-29: sounding: they become the Ks kept
  13                    SUB   00
  14                    TAC   out
  15                    SUB   00
  16                    TAC   cp
  17                    JMP   out
  18            cp      CLA   c80
  19                    STO   ld
  20                    CLA   s70
  21                    STO   st
  22            ld      DATA  0        (CLA 80 + k)
  23            st      DATA  0        (STO 70 + k)
  24                    CLA   ld
  25                    ADD   00
  26                    STO   ld
  27                    CLA   st
  28                    ADD   00
  29                    STO   st
  30                    SUB   s80
  31                    TAC   ld
  32            out     CLA   o70      32-39: the Ks kept out
  33                    STO   wr
  34            wr      DATA  0        (OUT 70 + k)
  35                    CLA   wr
  36                    ADD   00
  37                    STO   wr
  38                    SUB   o80
  39                    TAC   wr
  40                    JMP   frm
  50            snd     DATA  0
  51            i80     INP   80
  52            i90     INP   90
  53            c80     CLA   80
  54            s70     STO   70
  55            s80     STO   80
  56            o70     OUT   70
  57            o80     OUT   80
