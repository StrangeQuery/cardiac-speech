; Klatt's duration rules 9 and 10. Four cards a segment in (kind, nextk, p1, pf); out three factors in hundredths,
; 100 where none applies, then 0, so that every segment has the same number of cards (multiplying by 100 leaves
; PRCNT as it is). Rule 9, a vowel: p1 when phrase-final, else 70 + 3 p1 / 10. Rule 10, a vowel: 120 before a
; vowel, 70 after one; a consonant: 50 between consonants, 70 next to one (a pause is neither, and has no factors).
;
; Address Contents Label Opcode Operand Comment
  03            rec     INP   kind     03-16: a segment; a pause: three 100s
  04                    INP   nextk
  05                    INP   p1
  06                    INP   pf
  07                    CLA   kind
  08                    SUB   c8
  09                    TAC   sound
  10                    OUT   c100
  11                    OUT   c100
  12                    OUT   c100
  13                    OUT   z
  14                    CLA   z
  15                    STO   pkind
  16                    JMP   rec
  17            sound   CLA   kind
  18                    SUB   n2
  19                    TAC   v9
  20                    JMP   c10
  21            v9      CLA   pf       21-51: a vowel: rule 9; rule 10, before a vowel and after one
  22                    SUB   00
  23                    TAC   np
  24                    OUT   p1
  25                    JMP   v10
  26            np      CLA   p1
  27                    ADD   p1
  28                    ADD   p1
  29                    SFT   01
  30                    ADD   c70
  31                    STO   t
  32                    OUT   t
  33            v10     CLA   nextk
  34                    SUB   00
  35                    TAC   n100
  36                    SUB   00
  37                    TAC   n120
  38            n100    OUT   c100
  39                    JMP   p
  40            n120    OUT   c120
  41            p       CLA   pkind
  42                    SUB   00
  43                    TAC   p100
  44                    SUB   00
  45                    TAC   p70
  46            p100    OUT   c100
  47                    JMP   end
  48            p70     OUT   c70
  49                    JMP   end
  50            c10     CLA   z        50-76: a consonant: t = consonants next to it, 50, 70 or 100
  51                    STO   t
  52                    CLA   pkind
  53                    SUB   n2
  54                    TAC   cn
  55                    CLA   00
  56                    STO   t
  57            cn      CLA   nextk
  58                    SUB   n2
  59                    TAC   cc
  60                    CLA   t
  61                    ADD   00
  62                    STO   t
  63            cc      CLA   t
  64                    SUB   00
  65                    TAC   k100
  66                    SUB   00
  67                    TAC   k70
  68                    OUT   c50
  69                    JMP   k
  70            k100    OUT   c100
  71                    JMP   k
  72            k70     OUT   c70
  73            k       OUT   c100
  74                    OUT   c100
  75            end     OUT   z
  76                    CLA   kind
  77                    STO   pkind
  78                    JMP   rec
  80            kind    DATA  0
  81            nextk   DATA  0
  82            p1      DATA  0
  83            pf      DATA  0
  84            pkind   DATA  0
  85            t       DATA  0
  86            z       DATA  0
  87            c8      DATA  8
  88            n2      DATA  2
  89            c70     DATA  70
  90            c100    DATA  100
  91            c120    DATA  120
  92            c50     DATA  50
