  24                    SUB   00
  25                    TAC   c6
  26                    OUT   c140
  27            c6      CLA   wf
  28                    SUB   00
  29                    TAC   o85
  30                    JMP   r7
  31            o85     OUT   c85
  32                    JMP   r7
  33            syl     CLA   pf       33-48: a vowel: rules 2, 3, 4 and 5
  34                    SUB   00
  35                    TAC   v60
  36                    OUT   c140
  37                    JMP   v4
  38            v60     OUT   c60
  39            v4      CLA   fs
  40                    SUB   00
  41                    TAC   v85
  42                    JMP   v5
  43            v85     OUT   c85
  44            v5      CLA   bef
  45                    ADD   after
  46                    SUB   00
  47                    TAC   r7
  48                    OUT   c80
  49            r7      CLA   s        49-95: rule 7
  50                    SUB   00
  51                    TAC   r7go
  52                    SUB   00
  53                    TAC   end
  54            r7go    CLA   kind
  55                    SUB   n2
  56                    TAC   r7v
  57                    SUB   00
  58                    TAC   r7s
  59                    JMP   o70
  60            r7s     CLA   nextk
  61                    SUB   00
  62                    TAC   o70
  63                    SUB   00
  64                    TAC   o10
  65                    JMP   o70
  66            o10     OUT   c10
  67                    JMP   end
  68            o70     OUT   c70
  69                    JMP   end
  70            r7v     CLA   bef
  71                    ADD   after
  72                    SUB   n2
  73                    TAC   o70
  74                    OUT   c50
  75            end     OUT   z
  76                    JMP   rec
