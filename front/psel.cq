; A voiced frame's level grows with its pitch period: times sqrt(60 P) / 100, so its pulses carry the power of the
; frame whatever the pitch. Per frame three cards in: snd and V, and P; two out, the
; mode and factor for mulx: a sounding voiced frame mode 1 and 10 r, r = isqrt(60 P), else mode 0. The root counts
; the odd numbers 1, 3, 5 ... that can be taken away from 60 P, which is kept as thousands (hi) and units (lo):
; 6 P, then hi = 6 P / 100 (SFT 02) and lo = 10 (6 P mod 100) (SFT 21).
;
; Address Contents Label Opcode Operand Comment
  03            frm     INP   snd      03-20: a frame: is it sounding and voiced
  04            gv      INP   v
  05            gp      INP   p
  06                    CLA   z
  07                    STO   mode
  08                    STO   r
  09                    CLA   snd
  10                    SUB   00
  11                    TAC   out
  12                    SUB   00
  13                    TAC   on
  14                    JMP   out
  15            on      CLA   v
  16                    SUB   00
  17                    TAC   out
  18                    CLA   00
  19                    STO   mode
  20                    STO   odd
  21                    CLA   p        21-32: 60 P as thousands and units
  22                    ADD   p
  23                    ADD   p
  24                    ADD   p
  25                    ADD   p
  26                    ADD   p
  27                    STO   t
  28                    SFT   02
  29                    STO   hi
  30                    CLA   t
  31                    SFT   21
  32                    STO   lo
  33            lp      CLA   hi       33-57: take away odd numbers while they go
  34                    SUB   00
  35                    TAC   h0
  36            sb      CLA   lo
  37                    SUB   odd
  38                    TAC   bor
  39                    STO   lo
  40                    JMP   cnt
  41            bor     ADD   c500
  42                    ADD   c500
  43                    STO   lo
  44                    CLA   hi
  45                    SUB   00
  46                    STO   hi
  47            cnt     CLA   r
  48                    ADD   00
  49                    STO   r
  50                    CLA   odd
  51                    ADD   n2
  52                    STO   odd
  53                    JMP   lp
  54            h0      CLA   lo
  55                    SUB   odd
  56                    TAC   ten
  57                    JMP   sb
  58            ten     CLA   r        58-63: 10 r, and out
  59                    SFT   10
  60                    STO   r
  61            out     OUT   mode
  62                    OUT   r
  63                    JMP   frm
  70            snd     DATA  0
  71            v       DATA  0
  72            p       DATA  0
  73            mode    DATA  0
  74            r       DATA  0
  75            odd     DATA  0
  76            t       DATA  0
  77            hi      DATA  0
  78            lo      DATA  0
  79            z       DATA  0
  80            n2      DATA  2
  81            c500    DATA  500
