; The frames for the voice box. Per frame in: snd, V and A (from the level), P, its K10..K1 (from kcarry), and then
; the next frame's snd and V (the host deals the chooser's cards again from the second frame on). Out, the frame as
; the voice box reads it: V, P, A, K10..K1. A silent frame (snd 0) is unvoiced when a sounding voiced frame comes
; right after it, else voiced; an unvoiced frame's P is 0. The very last frame (snd 9) goes out voiced, and then -1,
; and a stop. The Ks are kept in cells 70-79 until V is known.
;
; Address Contents Label Opcode Operand Comment
  03            frm     INP   snd      03-12: a frame, its Ks into 70-79
  04                    INP   v
  05                    INP   a
  06                    INP   p
  07                    CLA   i70
  08                    STO   rd
  09            rd      DATA  0        (INP 70 + k)
  10                    CLA   rd
  11                    ADD   00
  12                    STO   rd
  13                    SUB   i80
  14                    TAC   rd
  15                    CLA   snd      15-37: the last frame; else the next frame's snd and V
  16                    SUB   c9
  17                    TAC   nxt
  18                    CLA   00
  19                    STO   v
  20                    JMP   emit
  21            nxt     INP   ns
  22                    INP   nv
  23                    CLA   snd
  24                    SUB   00
  25                    TAC   sil
  26                    SUB   00
  27                    TAC   emit
  28            sil     CLA   00
  29                    STO   v
  30                    CLA   ns
  31                    SUB   00
  32                    TAC   emit
  33                    SUB   00
  34                    TAC   chk
  35                    JMP   emit
  36            chk     CLA   nv
  37                    SUB   00
  38                    TAC   emit
  39                    CLA   z
  40                    STO   v
  41            emit    OUT   v        41-61: the frame out: V, P (0 when unvoiced), A, the ten Ks
  42                    CLA   v
  43                    SUB   00
  44                    TAC   p0
  45                    OUT   p
  46                    JMP   pa1
  47            p0      OUT   z
  48            pa1     OUT   a
  49                    CLA   o70
  50                    STO   wr
  51            wr      DATA  0        (OUT 70 + k)
  52                    CLA   wr
  53                    ADD   00
  54                    STO   wr
  55                    SUB   o80
  56                    TAC   wr
  57                    CLA   snd
  58                    SUB   c9
  59                    TAC   frm
  60                    OUT   m1
  61                    HRS   00
  62            snd     DATA  0
  63            v       DATA  0
  64            a       DATA  0
  65            p       DATA  0
  66            ns      DATA  0
  67            nv      DATA  0
  68            z       DATA  0
  69            c9      DATA  9
  80            m1      DATA  -1
  81            i70     INP   70
  82            i80     INP   80
  83            o70     OUT   70
  84            o80     OUT   80
